# ============================================================
# Unified Orchestrator — environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Values here take precedence over the legacy plaintext config.py.
# ============================================================

# ── API security ─────────────────────────────────────────────
# When set, every request (except /api/health and docs) must send a matching
# `x-api-key` header. When empty, only localhost clients are served.
# Frontend: set VITE_API_KEY to the same value.
API_KEY=

# Comma-separated CORS allowlist (frontend origins).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Reject uploads larger than this many bytes (default 100 MB).
MAX_UPLOAD_BYTES=104857600

# Comma-separated containers the download endpoint may read. Empty = no limit.
DOWNLOAD_CONTAINER_ALLOWLIST=

# ── Azure Service Principal (ADF + Blob management) ──────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Azure Data Factory ───────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_DATA_FACTORY=

# ── Azure Blob Storage ───────────────────────────────────────
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# ── Azure Databricks (compute plane) ─────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=
DATABRICKS_SPARK_VERSION=13.3.x-scala2.12
DATABRICKS_NODE_TYPE=Standard_DS3_v2
DATABRICKS_NOTEBOOK_BASE=/Shared/unified_orchestrator
# Secret scope the executor creates/updates to hand the storage key to jobs.
DATABRICKS_SECRET_SCOPE=unified-orchestrator
DATABRICKS_STORAGE_SECRET_KEY=azure-storage-key

# ── Planner backend ──────────────────────────────────────────
PLANNER_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
PLANNER_MODEL=planner-agent

# ── Groq (monitor/self-healing agents; planner fallback) ─────
GROQ_API_KEY=
